{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker phục vụ ảnh/nhạc thiệp trên R2 theo hợp đồng C6 (CLAUDE.md).
  // Đã deploy 2026-10-02: https://thien-phuong-media.phucanhdn01.workers.dev
  "name": "thien-phuong-media",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "thien-phuong-wedding-media"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
